# Define shared Airflow connection templates for platform service clients.
# The private copy is input to airflow connections import. It stays plaintext
# even when Airflow encrypts stored fields with its configured Fernet key.
# Copy this file, set matching credentials, and keep the populated copy private.
# Hosts and ports below address containers, not published host ports.

postgres_warehouse:
  conn_type: postgres
  # Airflow calls the database field schema; it selects warehouse, not a SQL schema.
  description: PostgreSQL warehouse database for Gold tables.
  host: postgres
  login: edai
  password: CHANGE_ME_POSTGRES_PASSWORD
  schema: warehouse
  port: 5432

postgres_metastore:
  conn_type: postgres
  description: Hive Metastore catalog tables. Never holds business data.
  host: postgres
  login: edai
  password: CHANGE_ME_POSTGRES_PASSWORD
  schema: metastore
  port: 5432

lakehouse_s3:
  conn_type: aws
  description: SeaweedFS S3 API for clients using the configured identity.
  host: seaweedfs
  login: CHANGE_ME_S3_ACCESS_KEY
  password: CHANGE_ME_S3_SECRET_KEY
  port: 8333
  # Extra is a JSON string inside YAML. Path style keeps the bucket in the URL
  # path because Compose DNS does not supply a separate hostname per bucket.
  extra: |
    {"endpoint_url": "http://seaweedfs:8333", "region_name": "us-east-1", "s3_addressing_style": "path"}

hive_metastore_thrift:
  conn_type: thrift
  description: Hive Metastore, where table and partition metadata lives.
  host: hive-metastore
  port: 9083

spark_thrift:
  conn_type: spark
  description: |
    HiveServer2 endpoint for Thrift clients. Its dbt profile starts a long-lived
    Spark application, which can hold worker cores unless capped at submission.
  host: spark-thrift
  port: 10001

spark_cluster:
  conn_type: spark
  description: Spark standalone master, for SparkSubmitOperator.
  host: spark-master
  port: 7077

trino_query:
  conn_type: trino
  description: Trino over the lakehouse and the warehouse. Query only.
  host: trino
  port: 8080

kafka_broker:
  conn_type: kafka
  description: Kafka broker on the internal container listener.
  host: kafka
  port: 29092

datahub_gms:
  conn_type: http
  description: DataHub GMS, where lineage and validation results are published.
  host: datahub-gms
  port: 8080
