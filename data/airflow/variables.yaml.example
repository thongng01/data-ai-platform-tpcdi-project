# Define shared Airflow variable values for pipeline clients.
# The populated copy contains credentials and stays private. Airflow 2 imports
# variables from JSON, so convert this YAML source before using that CLI command.
# Mounting this file does not expand values from infra/.env.

lakehouse_bucket: lakehouse
landing_bucket: landing

s3_endpoint: http://seaweedfs:8333
s3_access_key: CHANGE_ME_S3_ACCESS_KEY
s3_secret_key: CHANGE_ME_S3_SECRET_KEY

hive_metastore_uri: thrift://hive-metastore:9083
trino_host: trino
trino_port: "8080"

# ------------------------------------------------------------------ schema --
bronze_database: bronze
silver_database: silver
gold_database: gold
warehouse_database: warehouse

# Partition-column setting for clients that use date-partitioned files.
# This variable does not create partitions or choose a Delta table layout.
partition_column: dt

# ------------------------------------------------------------------ batches --
# BatchN directory names belong to the TPC-DI delivery contract. These values
# configure clients of that layout; they do not set the generator run dates.
generator_batches: Batch1,Batch2,Batch3
generator_scale: "0.02"

# ------------------------------------------------------------------ quality --
# Validation clients must apply these limits explicitly. The row limit is a
# count; the duplicate ratio is a fraction from 0 to 1. Declaring a variable does
# not create a check or decide whether a failure stops a pipeline.
min_silver_rows_trade: "1000"
max_duplicate_ratio: "0.05"
