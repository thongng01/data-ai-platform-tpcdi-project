dim_customer:::entity {
    NUM(11) SK_CustomerID PK
    NUM(11) CustomerID "business key"
    CHAR(10) Status
    NUM(1) Tier
    CHAR(30) AgencyID "matched prospect"
    DATE EffectiveDate
    DATE EndDate
}
dim_account:::entity {
    NUM(11) SK_AccountID PK
    NUM(11) AccountID "business key"
    NUM(11) SK_CustomerID FK
    NUM(11) SK_BrokerID FK
    CHAR(10) Status
    DATE EffectiveDate
    DATE EndDate
}
dim_broker:::entity {
    NUM(11) SK_BrokerID PK
    NUM(11) BrokerID "business key"
    DATE EffectiveDate
    DATE EndDate
}
dim_company:::entity {
    NUM(11) SK_CompanyID PK
    NUM(11) CompanyID "business key, CIK"
    CHAR(60) Name
    CHAR(50) Industry
    DATE EffectiveDate
    DATE EndDate
}
dim_security:::entity {
    NUM(11) SK_SecurityID PK
    CHAR(15) Symbol "business key"
    NUM(11) SK_CompanyID FK
    SNUM Dividend
    DATE EffectiveDate
    DATE EndDate
}
financial:::state {
    NUM(11) SK_CompanyID FK
    NUM(4) FI_YEAR
    NUM(1) FI_QTR
    SNUM FI_BASIC_EPS
}
dim_trade:::entity {
    NUM(15) TradeID PK
    NUM(11) SK_AccountID FK
    NUM(11) SK_CustomerID FK
    NUM(11) SK_BrokerID FK
    NUM(11) SK_SecurityID FK
    NUM(11) SK_CompanyID FK
    NUM(11) SK_CreateDateID FK
    NUM(11) SK_CreateTimeID FK
    NUM(11) SK_CloseDateID FK
    NUM(11) SK_CloseTimeID FK
    CHAR(10) Status
    CHAR(12) Type
}
fact_holdings:::event {
    NUM(15) TradeID FK
    NUM(15) CurrentTradeID FK
    NUM(11) SK_AccountID FK
    NUM(11) SK_CustomerID FK
    NUM(11) SK_SecurityID FK
    NUM(11) SK_CompanyID FK
    NUM(11) SK_DateID FK
    NUM(11) SK_TimeID FK
    SNUM(6) CurrentHolding
}
fact_cash_balances:::event {
    NUM(11) SK_AccountID FK
    NUM(11) SK_CustomerID FK
    NUM(11) SK_DateID FK
    SNUM Cash
}
fact_market_history:::event {
    NUM(11) SK_SecurityID FK
    NUM(11) SK_CompanyID FK
    NUM(11) SK_DateID FK
    NUM(11) SK_FiftyTwoWeekHighDate FK
    NUM(11) SK_FiftyTwoWeekLowDate FK
    NUM ClosePrice
    NUM(12) Volume
}
fact_watches:::event {
    NUM(11) SK_CustomerID FK
    NUM(11) SK_SecurityID FK
    NUM(11) SK_DateID_DatePlaced FK
    NUM(11) SK_DateID_DateRemoved FK
}
prospect:::state {
    CHAR(30) AgencyID PK
    NUM(11) SK_RecordDateID FK
    NUM(11) SK_UpdateDateID FK
    BOOLEAN IsCustomer
}
dim_date:::reference {
    NUM(11) SK_DateID PK
    DATE DateValue
}
dim_time:::reference {
    NUM(11) SK_TimeID PK
    TIME TimeValue
}
industry:::reference {
    CHAR(2) IN_ID PK
    CHAR(50) IN_NAME
}
status_type:::reference {
    CHAR(4) ST_ID PK
    CHAR(10) ST_NAME
}
tax_rate:::reference {
    CHAR(4) TX_ID PK
    CHAR(50) TX_NAME
    NUM TX_RATE
}
trade_type:::reference {
    CHAR(3) TT_ID PK
    CHAR(12) TT_NAME
}
fact_cash_transactions:::event {
    ID CT_ID PK "global source sequence"
}
