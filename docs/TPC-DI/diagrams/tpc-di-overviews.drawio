        <mxCell id="tpc-di-input-overview-text-11" value="Trade.txt supplies trade states.&#10;TradeHistory.txt supplies&#10;historical status changes.&#10;HoldingHistory.txt records changes." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Ubuntu Sans;fontSize=18;fontColor=#183246;fontStyle=0;" vertex="1" parent="tpc-di-input-overview-trade">
