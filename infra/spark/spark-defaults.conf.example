# Configure submitted Spark applications, Hive catalog access, and S3A storage.
# Compose mounts this file into Spark containers. Applications read defaults at
# submission; daemon limits still come from daemon settings and arguments.
# Values are literal: this mounted file does not substitute infra/.env variables.

# ---------------------------------------------------------------- the cluster --
# Applications use the standalone master unless submission overrides it.
# The worker receives its master address separately in the Compose command.
spark.master spark://spark-master:7077

# ---------------------------------------------------------------- metastore --
# Use the shared Hive Metastore for named tables instead of a session-only
# catalog. Writing files alone does not register a table in that catalog.
spark.sql.catalogImplementation  hive
spark.hadoop.hive.metastore.uris thrift://hive-metastore:9083

# Use the Hive client bundled with Spark instead of downloading another set.
# This selects the client libraries; it does not prove server compatibility.
spark.sql.hive.metastore.jars builtin

# ------------------------------------------------------------- object store --
spark.sql.warehouse.dir s3a://lakehouse/warehouse
spark.hadoop.fs.s3a.impl org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.endpoint http://seaweedfs:8333
spark.hadoop.fs.s3a.path.style.access true
spark.hadoop.fs.s3a.connection.ssl.enabled false
spark.hadoop.fs.s3a.access.key CHANGE_ME_S3_ACCESS_KEY
spark.hadoop.fs.s3a.secret.key CHANGE_ME_S3_SECRET_KEY
spark.hadoop.fs.s3a.aws.credentials.provider org.apache.hadoop.fs.s3a.SimpleAWSCredentialsProvider

# Request unchunked AWS payloads. Hadoop passes only recognized properties to
# its SDK, so verify the encoding on the wire when testing a different version.
spark.hadoop.fs.s3a.aws.chunkedEncoding false

# Bound S3A retries for transient errors. The retry interval is in milliseconds;
# exhausting retries still fails the operation. Connection and thread limits
# bound client concurrency, not the whole service workload.
spark.hadoop.fs.s3a.retry.limit 7
spark.hadoop.fs.s3a.retry.interval 1000
spark.hadoop.fs.s3a.connection.maximum 200
spark.hadoop.fs.s3a.threads.max 64

# ----------------------------------------------------------------- dynamic --
# For supported partitioned data-source writes, dynamic overwrite replaces only
# partitions that receive rows. It does not clear a partition with no new rows.
# Hive dynamic partition settings below apply to Hive writes, not Delta commits.
spark.sql.sources.partitionOverwriteMode dynamic
spark.sql.hive.exec.dynamic.partition true
spark.sql.hive.exec.dynamic.partition.mode nonstrict

# ------------------------------------------------------------------ sizing --
# The worker advertises six cores and 5 GiB. Each requested executor has two
# cores and a 1 GiB heap; additional process memory also counts against limits.
# Executor instances is not a total-core cap in standalone mode. Set
# spark.cores.max per application when it must leave cores for other work.
# Applications can wait for resources without failing; inspect the master UI.
spark.driver.memory 1g
spark.driver.maxResultSize 512m
spark.executor.memory 1g
spark.executor.cores 2
spark.executor.instances 1
spark.memory.fraction 0.5
spark.memory.storageFraction 0.3

# Exclude executors or nodes after repeated task failures. The 120-second
# timeout lets excluded resources become eligible again; it is not a timeout
# for waiting on cluster resources.
spark.excludeOnFailure.enabled true
spark.excludeOnFailure.timeout 120s

# Adaptive execution can split skewed shuffle partitions in supported joins.
# A partition must exceed both the median-size factor and byte threshold to
# qualify as skewed. Coalescing combines small partitions toward 128 MiB.
spark.sql.adaptive.enabled true
spark.sql.adaptive.coalescePartitions.enabled true
spark.sql.adaptive.skewJoin.enabled true
spark.sql.adaptive.skewJoin.skewedPartitionFactor 3
spark.sql.adaptive.skewJoin.skewedPartitionThresholdInBytes 256m
spark.sql.adaptive.advisoryPartitionSizeInBytes 128m

# Compress Parquet pages with Zstandard. Compression can reduce bytes, but it
# does not reduce the number of files; measure both for storage experiments.
spark.sql.parquet.compression.codec zstd
spark.sql.parquet.enable.dictionary true

# Kryo applies to supported serialized objects, not all Spark SQL operations.
# UTC keeps timestamp interpretation independent of the container time zone.
spark.serializer org.apache.spark.serializer.KryoSerializer
spark.sql.session.timeZone UTC

# Save application events for a Spark History Server to read after a run.
# The prefix must exist before startup; bootstrap seeds it with a marker object.
# Rolling limits each log segment to 64 MiB, not the total retained log size.
spark.eventLog.enabled true
spark.eventLog.dir s3a://lakehouse/spark-logs
spark.eventLog.rolling true
spark.eventLog.maxFileSize 64m
spark.ui.showConsoleProgress false
spark.ui.enabled true
spark.ui.retainedJobs 200
spark.ui.retainedStages 400
