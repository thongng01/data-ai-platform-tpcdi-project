# Configure the Trino JVM heap, garbage collector, and failure diagnostics.
# The 1 GiB heap is smaller than the container limit to leave non-heap space.
# G1 chooses generation sizes; the region-size option does not fix young-gen size.

-server
-Xmx1G
-XX:InitialRAMPercentage=32
-XX:+UseG1GC
-XX:G1HeapRegionSize=32M
-XX:+ExplicitGCInvokesConcurrent
# Exit on heap exhaustion so container restart policy can replace the process.
# Keep stack traces for repeated exceptions to support failure diagnosis.
-XX:+ExitOnOutOfMemoryError
-XX:-OmitStackTraceInFastThrow
-XX:ReservedCodeCacheSize=256M
-Djdk.attach.allowAttachSelf=true
# Bound each cached temporary NIO buffer to 2,000,000 bytes.
-Djdk.nio.maxCachedBufferSize=2000000
-XX:+UnlockDiagnosticVMOptions
-XX:G1NumCollectionsKeepPinned=10000000
