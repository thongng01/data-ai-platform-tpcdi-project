# Configure Trino access to the PostgreSQL warehouse database.
# Gold is the queryable zone for business intelligence and validation checks.
# Trino can join its tables to the Hive catalog in one SQL query. These literal
# credentials must match the existing PostgreSQL role; .env is not expanded here.

connector.name=postgresql
connection-url=jdbc:postgresql://postgres:5432/warehouse
connection-user=edai
connection-password=CHANGE_ME_POSTGRES_PASSWORD
