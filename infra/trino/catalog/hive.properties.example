# Configure the Hive connector for Parquet tables on SeaweedFS.
# Hive Metastore supplies table locations and schemas; the native S3 client
# reads object data. Values are literal and must match the private service config.

connector.name=hive
hive.metastore.uri=thrift://hive-metastore:9083

# ------------------------------------------------- native S3 filesystem -----
# The native filesystem property name is version-specific. Validate it against
# the Trino image before an upgrade; unknown properties can prevent startup.
fs.native-s3.enabled=true
s3.endpoint=http://seaweedfs:8333
s3.region=us-east-1
s3.path-style-access=true
s3.aws-access-key=CHANGE_ME_S3_ACCESS_KEY
s3.aws-secret-key=CHANGE_ME_S3_SECRET_KEY

# Disable exclusive-create requests for stores that do not support the
# required conditional PUT operation. This removes that write-conflict guard;
# it is not a substitute for table-format concurrency control.
s3.exclusive-create=false

# Multipart upload size is 8 MiB per part. This is a write setting, not a
# Parquet read block size. Timeouts bound individual network operations.
s3.streaming.part-size=8MB
s3.max-connections=100
s3.max-error-retries=5
s3.socket-connect-timeout=30s
s3.socket-read-timeout=60s

# ------------------------------------------------------------- metastore ----
# Bound the number of Hive partitions in one scan. Ignoring an absent
# partition directory can omit data, so check missing inputs separately.
hive.max-partitions-per-scan=100000
hive.ignore-absent-partitions=true
hive.recursive-directories=false

# Permit explicit partition registration instead of requiring a directory scan.
# Registration changes catalog metadata; it does not create data files.
hive.allow-register-partition-procedure=true

# Match Parquet fields by name rather than ordinal position. Catalog schema
# updates still need to expose any new columns to queries.
hive.parquet.use-column-names=true

# Block writes to non-managed Hive tables but allow their creation in the
# catalog. These flags do not make all Trino catalogs or managed tables read-only.
hive.non-managed-table-writes-enabled=false
hive.non-managed-table-creates-enabled=true
