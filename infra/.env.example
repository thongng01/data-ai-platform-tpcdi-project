# Configure local Compose services, image versions, ports, and credentials.
#
# Docker Compose reads these values when it loads the configuration. A container
# receives a value only when its service passes that value through environment.
#
# Copy to `infra/.env` and replace credential placeholders before startup.
# Keep the local copy private. Never commit real credentials.

# ---------------------------------------------------------------- project ---
# Project scope determines generated container, network, and volume names.
# Changing it selects different volumes; it does not move an existing database.
COMPOSE_PROJECT_NAME=brokerage

# Run Compose from infra/ so these relative file paths resolve consistently.
# Compose loads all five files; profiles select optional services to start.
COMPOSE_FILE=compose.yaml:compose.compute.yaml:compose.streaming.yaml:compose.orchestration.yaml:compose.governance.yaml

# ---------------------------------------------------------------- versions --
POSTGRES_IMAGE=postgres:16-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
HIVE_METASTORE_IMAGE=starburstdata/hive:3.1.2-e.18
TRINO_IMAGE=trinodb/trino:476
SPARK_IMAGE=brokerage/spark:3.5.3
KAFKA_IMAGE=confluentinc/cp-kafka:7.7.1
FLINK_IMAGE=brokerage/flink:1.20.1
AIRFLOW_BASE_IMAGE=apache/airflow:2.10.5-python3.11
AIRFLOW_IMAGE=brokerage/airflow:2.10.5
DATAGEN_IMAGE=brokerage/datagen:dev
SODA_IMAGE=brokerage/soda:dev
BOOTSTRAP_IMAGE=brokerage/bootstrap:dev
TOOLS_IMAGE=brokerage/tools:dev

# ------------------------------------------------------------- governance ---
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.3
DATAHUB_UPGRADE_IMAGE=acryldata/datahub-upgrade:v1.5.0.6
DATAHUB_GMS_IMAGE=acryldata/datahub-gms:v1.5.0.6
DATAHUB_FRONTEND_IMAGE=acryldata/datahub-frontend-react:v1.5.0.6
DATAHUB_ACTIONS_IMAGE=acryldata/datahub-actions:v0.0.15
DATAHUB_INGEST_IMAGE=brokerage/datahub-ingest:dev

# ----------------------------------------------------------------- postgres --
# This role also appears in the PostgreSQL catalog and Airflow templates.
# Renaming a role in a populated database requires a separate SQL migration.
POSTGRES_USER=edai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432
# Databases created by the bootstrap service inside the single Postgres instance.
POSTGRES_DB_WAREHOUSE=warehouse
POSTGRES_DB_METASTORE=metastore
POSTGRES_DB_AIRFLOW=airflow
POSTGRES_DB_DATAHUB=datahub

# ---------------------------------------------------------------- seaweedfs --
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
SEAWEEDFS_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
# Buckets created by the bootstrap service.
LAKEHOUSE_BUCKET=lakehouse
LANDING_BUCKET=landing

# ------------------------------------------------------------ hive metastore --
HIVE_METASTORE_PORT=9083

# --------------------------------------------------------------------- trino --
TRINO_PORT=8081

# --------------------------------------------------------------------- spark --
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8082
SPARK_WORKER_UI_PORT=8083
SPARK_THRIFT_PORT=10001

# --------------------------------------------------------------------- kafka --
KAFKA_PORT=9092
# KRaft stores this ID with broker data. Do not change it to rename resources.
KAFKA_CLUSTER_ID=edai-coursework-cluster

# --------------------------------------------------------------------- flink --
FLINK_UI_PORT=8084

# ------------------------------------------------------------------- airflow --
AIRFLOW_PORT=8085
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=CHANGE_ME_AIRFLOW_PASSWORD

# ------------------------------------------------------------------- datahub --
DATAHUB_FRONTEND_PORT=9002
# The Spark UI uses 8082. Services cannot bind the same host port when both run.
DATAHUB_GMS_PORT=8086
OPENSEARCH_PORT=9200

# ------------------------------------------------------------------ airflow --
# Airflow needs this to encrypt Variables and Connections in its metadata
# database. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# ----------------------------------------------------- profiles to auto-start --
# Set COMPOSE_PROFILES in your shell, or pass `--profile` flags to `docker compose`.
# COMPOSE_PROFILES=compute
# COMPOSE_PROFILES=compute,stream,airflow
# COMPOSE_PROFILES=compute,stream,airflow,governance

# Generate separate random values for these application signing secrets.
AIRFLOW_WEBSERVER_SECRET_KEY=
DATAHUB_SECRET=
