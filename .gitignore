# Local workspace: scratch files, archives, coursework rubric, reference checkouts, and sample data.
/local/

# Exclude draw.io binaries and npm packages inside the diagram tool.
/workflow/tools/diagrams/drawio/
/workflow/tools/diagrams/node_modules/

# Python environments. Machine-specific, regenerated from pyproject.toml.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ruff_cache/

# Large binaries, wherever they land. A database dump has no place in history.
*.db
*.duckdb
*.sqlite
*.sqlite3

# Local overrides and secrets. None committed; this is here so a stray .env
# cannot land by accident.
.env
.env.*
!.env.example

# Exception: infra/.env is the platform's configuration, not a secret file.
# Every value in it is a local development default, there is no production
# credential anywhere in this repository, and Docker Compose reads it at parse
# time, so without it a fresh clone has no port map and no service config. Copy
# it and edit locally if you need to; do not put a real credential in it.
!infra/.env

# Editor and OS noise.
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
