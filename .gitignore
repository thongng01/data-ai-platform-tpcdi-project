# Temporary files stay local. Reusable helpers in misc/tools/ belong in Git.
/misc/tmp/

# Keep local archives, reference checkouts, and generated data out of Git.
/misc/archive/
/misc/tpcdi/
/misc/generator-feasibility/
/misc/sample_run/
/misc/data/
/misc/clean_run/
/misc/tpcdi_out/
/misc/abandoned-tpcds/

# Exclude draw.io application binaries if copied into the workspace.
/misc/tools/diagrams/drawio/

# Python environments. Machine-specific, regenerated from pyproject.toml.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ruff_cache/

# Large binaries, wherever they land. A database dump has no place in history.
*.db
*.duckdb
*.sqlite
*.sqlite3

# Personal scratch notes. Move anything worth keeping into docs/.
.scratch/

# Local overrides and secrets. None committed; this is here so a stray .env
# cannot land by accident.
.env
.env.*
!.env.example

# Exception: infra/.env is the platform's configuration, not a secret file.
# Every value in it is a local development default, there is no production
# credential anywhere in this repository, and Docker Compose reads it at parse
# time, so without it a fresh clone has no port map and no service config. Copy
# it and edit locally if you need to; do not put a real credential in it.
!infra/.env

# Course reference material stays local.
docs/course/

# Editor and OS noise.
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
