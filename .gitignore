# Local workspace: scratch files, archives, reference checkouts, and sample data.
/local/

# Exclude draw.io binaries and npm packages inside the diagram tool.
/workflow/tools/diagrams/drawio/
/workflow/tools/diagrams/node_modules/

# Python environments. Machine-specific, regenerated from pyproject.toml.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ruff_cache/

# Large binaries, wherever they land. A database dump has no place in history.
*.db
*.duckdb
*.sqlite
*.sqlite3

# Local environment files. Commit only placeholder examples.
.env
.env.*
!.env.example

# Populated service configuration contains credentials.
/infra/seaweedfs/s3.json
/infra/spark/spark-defaults.conf
/infra/trino/catalog/*.properties
/data/airflow/connections.yaml
/data/airflow/variables.yaml

# Private keys, credential stores, and infrastructure state.
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
.aws/
.ssh/
secrets/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# Editor and OS noise.
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
